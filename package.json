{
  "name": "taskflow-deployment",
  "private": true,
  "engines": {
    "node": ">=22.12.0 <23 || >=24.0.0"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "@scarf/scarf@1.4.0": false,
    "prisma@7.10.1": true
  },
  "workspaces": [
    "TaskFlow-Back-main"
  ],
  "scripts": {
    "start": "node TaskFlow-Back-main/server.js",
    "test": "npm run test --workspace=TaskFlow-Back-main",
    "db:pull": "prisma db pull",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "postinstall": "npm run db:generate"
  }
}
