generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model cards {
  id         Int       @id @default(autoincrement())
  texto      String
  coluna     String    @db.VarChar(50)
  ordem      Int?      @default(0)
  projeto_id Int
  usuario_id Int
  criado_em  DateTime? @default(now()) @db.Timestamp(6)
  projetos   projetos  @relation(fields: [projeto_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_cards_projeto")
  usuarios   usuarios  @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_cards_usuario")
}

model clientes {
  id              Int       @id @default(autoincrement())
  nome            String    @db.VarChar(100)
  data_nascimento DateTime  @db.Date
  pedidos         pedidos[]
}

model comentarios {
  id            Int       @id @default(autoincrement())
  texto         String
  tarefa_id     Int?
  usuario_id    Int
  criado_em     DateTime? @default(now()) @db.Timestamp(6)
  atualizado_em DateTime? @default(now()) @db.Timestamp(6)
  tarefas       tarefas?  @relation(fields: [tarefa_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_comentarios_tarefa")
  usuarios      usuarios  @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_comentarios_usuario")
}

model pedidos {
  id           Int            @id @default(autoincrement())
  data         DateTime?      @db.Timestamp(6)
  idcliente    Int?
  clientes     clientes?      @relation(fields: [idcliente], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pedidositens pedidositens[]
}

model pedidositens {
  id         Int       @id @default(autoincrement())
  idpedido   Int?
  idproduto  Int?
  valor      Decimal   @db.Decimal(18, 2)
  desconto   Decimal   @db.Decimal(18, 2)
  quantidade Decimal   @db.Decimal(11, 2)
  pedidos    pedidos?  @relation(fields: [idpedido], references: [id], onDelete: NoAction, onUpdate: NoAction)
  produtos   produtos? @relation(fields: [idproduto], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model produtos {
  id                Int             @id @default(autoincrement())
  descricao         String?         @db.VarChar(100)
  idunidadedemedida Int?
  pedidositens      pedidositens[]
  unidadesmedida    unidadesmedida? @relation(fields: [idunidadedemedida], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model projetos {
  id         Int       @id @default(autoincrement())
  nome       String    @db.VarChar(100)
  descricao  String?
  usuario_id Int
  criado_em  DateTime? @default(now()) @db.Timestamp(6)
  cards      cards[]
  usuarios   usuarios  @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_projetos_usuario")
  tarefas    tarefas[]
}

model tarefas {
  id           Int           @id @default(autoincrement())
  texto        String
  coluna       String        @db.VarChar(30)
  ordem        Int?          @default(0)
  projeto_id   Int
  usuario_id   Int
  criado_em    DateTime?     @default(now()) @db.Timestamp(6)
  idprioridade Int
  comentarios  comentarios[]
  projetos     projetos      @relation(fields: [projeto_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_tarefas_projeto")
  usuarios     usuarios      @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_tarefas_usuario")
}

model unidadesmedida {
  id        Int        @id @default(autoincrement())
  sigla     String     @db.VarChar(3)
  descricao String?    @db.VarChar(30)
  produtos  produtos[]
}

model usuarios {
  id            Int           @id @default(autoincrement())
  nome          String        @db.VarChar(100)
  email         String        @unique @db.VarChar(150)
  senha_hash    String        @db.VarChar(255)
  criado_em     DateTime?     @default(now()) @db.Timestamp(6)
  atualizado_em DateTime?     @default(now()) @db.Timestamp(6)
  cards         cards[]
  comentarios   comentarios[]
  projetos      projetos[]
  tarefas       tarefas[]
}
