{
  "version": 2,
  "builds": [
    {
      "src": "TaskFlow-Back-main/server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": "node_modules/swagger-ui-dist/**"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "TaskFlow-Back-main/server.js"
    }
  ]
}
